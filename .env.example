# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Server
PORT=8080
HAVNAI_MANIFEST_DIR=/app/server/manifests
HAVNAI_MANIFEST_FILE=/app/server/manifests/registry.json
HAVNAI_OUTPUTS_DIR=/app/static/outputs
SERVER_JOIN_TOKEN=changeme

# Rewards
REWARD_BASE_HAI=0.05
REWARD_BASELINE_RUNTIME=8.0
REWARD_SDXL_FACTOR=1.5
REWARD_SD15_FACTOR=1.0
REWARD_ANIME_FACTOR=0.7

# Database
# Leave DATABASE_URL blank to use SQLite (development/single-node).
# Set to a postgres:// URI for production.
# DATABASE_URL=postgresql://havnai:changeme@localhost:5432/havnai
# POSTGRES_PASSWORD=changeme

# Stripe (leave blank to disable payments)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Blockchain / HAI token funding (Sepolia testnet)
# HAVNAI_HAI_FUNDING_ENABLED=1
# HAVNAI_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# HAVNAI_HAI_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# HAVNAI_HAI_TREASURY_WALLET=0x0000000000000000000000000000000000000000

# CORS origins (comma-separated, production should be explicit)
# CORS_ORIGINS=https://joinhavn.io,https://www.joinhavn.io

# Invite gating
# HAVNAI_INVITE_GATING=1

# Credits system
# HAVNAI_CREDITS_ENABLED=1
