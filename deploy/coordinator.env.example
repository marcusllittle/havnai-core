HAVNAI_DB_PATH=/var/lib/havnai/ledger.db
HAVNAI_NODES_PATH=/var/lib/havnai/nodes.json
HAVNAI_STATIC_DIR=/var/lib/havnai/static
HAVNAI_OUTPUTS_DIR=/var/lib/havnai/static/outputs
HAVNAI_ASSETS_DIR=/var/lib/havnai/static/assets
HAVNAI_OWNER_TOKEN=replace-with-a-long-random-owner-token
HAVNAI_NODE_TOKEN=replace-with-a-long-random-node-token
HAVNAI_ADMIN_TOKEN=replace-with-a-long-random-admin-token
SERVER_JOIN_TOKEN=replace-with-the-same-node-token-during-compatibility-release
HAVNAI_VIDEO_V2_ENABLED=0
HAVNAI_JOB_LEASE_SECONDS=90
HAVNAI_MIN_FREE_DISK_BYTES=5368709120
HAVNAI_ARTIFACT_RETENTION_DAYS=30
CORS_ORIGINS=https://joinhavn.io,https://www.joinhavn.io
