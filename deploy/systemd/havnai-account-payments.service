[Unit]
Description=Reconcile HavnAI account credit payments against Stripe
After=network-online.target havnai-coordinator.service
Wants=network-online.target

[Service]
Type=oneshot
User=havnai
Group=havnai
WorkingDirectory=/opt/havnai/current/server
EnvironmentFile=/etc/havnai/coordinator.env
ExecStart=/opt/havnai/venv/bin/python /opt/havnai/current/server/account_payments.py --database ${HAVNAI_DB_PATH} --batch --limit 25
TimeoutStartSec=4min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/havnai /var/log/havnai
