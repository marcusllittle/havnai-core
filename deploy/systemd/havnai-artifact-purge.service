[Unit]
Description=Purge expired HavnAI deleted artifacts
After=havnai-coordinator.service

[Service]
Type=oneshot
User=havnai
Group=havnai
WorkingDirectory=/opt/havnai/current/server
EnvironmentFile=/etc/havnai/coordinator.env
ExecStart=/opt/havnai/venv/bin/python /opt/havnai/current/server/artifact_lifecycle.py --database ${HAVNAI_DB_PATH} --outputs-dir ${HAVNAI_OUTPUTS_DIR} --limit 25
TimeoutStartSec=4min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/havnai /var/log/havnai
