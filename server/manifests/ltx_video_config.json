{
  "_comment": [
    "Configuration for the LTX-Video 0.9.x checkpoints installed on the RTX 3060 node.",
    "Only implemented and runtime-verifiable capabilities are advertised."
  ],
  "family": "ltx_video",
  "version": "0.9.x",
  "provider": "Lightricks",
  "base_dir": "/mnt/d/havnai-storage/models/ltx_video",
  "checkpoints": {
    "dev": {
      "filename": "ltx-video-2b-v0.9.5.safetensors",
      "description": "LTX-Video 2B 0.9.5 development checkpoint",
      "dtype": "bfloat16",
      "size_hint_gb": 6.4
    },
    "distilled": {
      "filename": "ltxv-2b-0.9.8-distilled.safetensors",
      "description": "LTX-Video 2B 0.9.8 distilled checkpoint",
      "dtype": "bfloat16",
      "size_hint_gb": 6.4
    }
  },
  "assets": {
    "text_encoder": {
      "type": "huggingface",
      "repo_id": "Lightricks/LTX-Video",
      "subfolder": "text_encoder",
      "description": "Text encoder resolved by the official pipeline",
      "dtype": "bfloat16"
    }
  },
  "pipeline_modes": {
    "one_stage": {
      "description": "LTX-Video 0.9.5 text-to-video and first-frame image-to-video",
      "requires_checkpoint": ["dev"],
      "requires_assets": ["text_encoder"],
      "optional_assets": [],
      "supports_image_input": true,
      "supports_audio_input": false,
      "supports_keyframes": false,
      "supports_retake": false,
      "default_steps": 12,
      "default_guidance": 3.0,
      "default_width": 640,
      "default_height": 384,
      "default_frames": 49,
      "default_fps": 16,
      "max_frames": 161,
      "max_width": 1280,
      "max_height": 1280
    },
    "distilled_fast": {
      "description": "LTX-Video 0.9.8 distilled text-to-video and first-frame image-to-video",
      "requires_checkpoint": ["distilled"],
      "requires_assets": ["text_encoder"],
      "optional_assets": [],
      "supports_image_input": true,
      "supports_audio_input": false,
      "supports_keyframes": false,
      "supports_retake": false,
      "default_steps": 8,
      "default_guidance": 1.0,
      "default_width": 640,
      "default_height": 384,
      "default_frames": 65,
      "default_fps": 16,
      "max_frames": 161,
      "max_width": 1280,
      "max_height": 1280
    }
  },
  "capabilities": [
    "text_to_video",
    "image_to_video",
    "distilled_inference"
  ],
  "defaults": {
    "pipeline_mode": "distilled_fast",
    "checkpoint_variant": "distilled",
    "dtype": "bfloat16",
    "device": "cuda",
    "cpu_offload_threshold_gb": 16,
    "vae_slicing": true,
    "timeout_seconds": 600
  }
}
